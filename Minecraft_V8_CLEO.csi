
{$CLEO .cs}
03A4: name_thread 'MCV8'

:INICIO
0001: wait 0
00D6: if 0
0256: player $PLAYER_CHAR defined
004D: jump_if_false @INICIO
0247: request_model 1655

:CARREGAR
0001: wait 0
00D6: if 0
0248: model 1655 available
004D: jump_if_false @CARREGAR
04C4: create_coordinate 0@ 1@ 2@ from_actor $PLAYER_ACTOR offset 0.0 3.0 0.0
0107: 3@ = create_object 1655 at 0@ 1@ 2@
0249: release_model 1655
0A93: end_custom_thread
